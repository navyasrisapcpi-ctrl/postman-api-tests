  "item": [
    {
      "name": "15. Status code test Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Response time is under 2000ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Content-Type is application/json\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Response body has required fields\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"userId\");",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.expect(json).to.have.property(\"title\");",
              "    pm.expect(json).to.have.property(\"body\");",
              "});",
              "",
              "pm.test(\"Field types are correct\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.userId).to.be.a(\"number\");",
              "    pm.expect(json.id).to.be.a(\"number\");",
              "    pm.expect(json.title).to.be.a(\"string\");",
              "    pm.expect(json.body).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"userId is 1\", () => {",
              "    pm.expect(pm.response.json().userId).to.eql(1);",
              "});",
              "",
              "pm.test(\"id is 1\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(1);",
              "});",
              "",
              "pm.test(\"title and body are non-empty strings\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.title).to.not.be.empty;",
              "    pm.expect(json.body).to.not.be.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
